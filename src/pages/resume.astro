---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5 mt-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    Software Consultant Team Manager with 7 years of delivering tax and motor carrier system modernization projects for state agencies. I help government clients modernize their software by leading technical teams, architecting integrations, and translating requirements into solutions that drive measurable outcomes.
    Outside of work, my areas of academic interest are related to space travel, environmental preservation, and science and technology in society (STS).
    As somebody who minored in philosophy, I'm also always interested in exploring the ethical considerations surrounding various technologies like AI and social media.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container mb-5">
    <TimeLineElement
      title="The University of Virginia"
      company="Bachelor of Science in Computer Science, Minor in Philosophy" 
      dates="August 2015 — December 2019"
      location="Charlottesville, VA"
    >

    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    
    <TimeLineElement
      title="Software Consultant Team Manager"
      dates="March 2026 — Present"
      company="FAST Enterprises, LLC"
      location="Richmond, VA"
    >
    <ul class="list-disc list-outside ms-5">
      <li>Designed and delivered a RESTful API with HMAC authentication to integrate Virginia DMV’s IFTA/IRP division with a third-party vendor for real-time Hauling Permit retrieval</li>
      <li>Delivered end-to-end user testing support and developed mission-critical features for the Virginia Department of Taxation’s software modernization project.</li>
    </ul>
      
    </TimeLineElement>

    <TimeLineElement
      title="Software Consultant Team Manager"
      dates="November 2024 — March 2026"
      company="FAST Enterprises, LLC"
      location="Oklahoma City, OK"
    >
    <ul class="list-disc list-outside ms-5">
      <li>Led a team of 7 developers through agile delivery cycles, conducting performance reviews, mentoring on code quality, and managing project timelines.</li>
      <li>Defined and delivered taxpayer self-serve payment plans with recurring monthly ACH payments, driving a 315% increase in payment plan dollars collected with $7M+ collected in the first year for the Oklahoma Tax Commission.</li>
      <li>Managed the full software development lifecycle for the agency's tax auditing software upgrade—gathered requirements, architected the solution, delegated development tasks, and coordinated testing efforts</li>
    </ul>
      
    </TimeLineElement>

    <TimeLineElement
      title="Software Consultant"
      dates="January 2022 — November 2024"
      company="FAST Enterprises, LLC"
      location="Washington, DC"
    >
    <ul class="list-disc list-outside ms-5 space-y-4">
      <li>Led cross-functional project team (executives, developers, data scientists) to model and report on large tax datasets for DC Office of Tax and Revenue, delivering insights that allowed equitable audit selection.</li>
      <li>Received a certificate from the Director of the Tax Systems Group for customer service, innovation, and advancing the agency's goals.</li>
    </ul>
      
    </TimeLineElement>

    <TimeLineElement
      title="Software Consultant"
      dates="January 2020 — January 2022"
      company="FAST Enterprises, LLC"
      location="Salt Lake City, UT"
    >
    <ul class="list-disc list-outside ms-5 space-y-4">
      <li>Gathered requirements and delivered production code and database schema for the Utah State Tax Commission's system modernization efforts.</li>
      <li>Oversaw the conversion of 4M+ name and address records as part of a major system upgrade.</li>
    </ul>
      
    </TimeLineElement>
    
    <TimeLineElement
    title="Student Researcher"
    dates="2018 — 2019"
    company="University of Virginia"
    location="Charlottesville, VA"
    
    >
    <ul class="list-disc list-outside ms-5">
      <li>Architected software that used the Python requests library and amazon EC2 instances to collect user profile data from Yelp.</li>
      <li>Analyzed scraped user review data using the difference in differences econometric technique between more-private and less-private users by using the Python Plotly and Statistics Libraries.</li>
      <li>This research was part of a project funded by the <a href="https://www.nsf.gov/awardsearch/showAward?AWD_ID=1915813&HistoricalAwards=false" class="link">National Science Foundation</a>.</li>
    </ul>
  </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills and Technologies</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>SQL</li>
    <li>PostgreSQL</li>
    <li>VB.NET</li>
    <li>C#</li>
    <li>Github</li>
    <li>Python</li>
    <li>Java</li>
    <li>HTML</li>
    <li>CSS</li>
    <li>Javascript</li>
    <li>Astro</li>
    <li>REST APIs</li>
  </ul>
</BaseLayout>
